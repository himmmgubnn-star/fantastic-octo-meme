# Discord application credentials from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_application_id_here

# Optional: register slash commands to a single guild during development (instant, vs ~1h global)
# DISCORD_GUILD_ID=your_test_guild_id

# Comma-separated Discord user IDs allowed to use the bot. Empty = everyone.
ALLOWED_USER_IDS=

# Comma-separated guild IDs where the bot may run. Empty = any guild.
ALLOWED_GUILD_IDS=

# Operational limits
MAX_CODE_BYTES=65536
MAX_OUTPUT_BYTES=262144
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=5

# Logging: error | warn | info | debug
LOG_LEVEL=info
